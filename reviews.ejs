<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/images.css">
    <style>
        .reviews-page { max-width: 1000px; margin: 0 auto; padding: 3rem 2rem; }
        .reviews-hero { text-align: center; padding: 3rem; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 20px; margin-bottom: 3rem; }
        .reviews-hero h1 { font-family: 'Playfair Display', serif; font-size: 3rem; color: white; }
        .reviews-hero h1 span { color: var(--gold); }
        .reviews-hero .stats { display: flex; justify-content: center; gap: 3rem; margin-top: 1.5rem; }
        .reviews-hero .stats .num { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--gold); display: block; }
        .reviews-hero .stats .label { color: rgba(255,255,255,0.7); }
        .form-box { background: white; padding: 2rem; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.08); margin-bottom: 3rem; }
        .form-box h2 { font-family: 'Playfair Display', serif; margin-bottom: 0.5rem; }
        .form-box .sub { color: #888; margin-bottom: 1.5rem; }
        .stars-selector { display: flex; gap: 0.5rem; font-size: 2.5rem; cursor: pointer; margin-bottom: 0.5rem; }
        .stars-selector .star { color: #ddd; transition: color 0.3s; }
        .stars-selector .star.active { color: var(--gold); }
        .rating-label { color: #888; display: block; margin-bottom: 1rem; }
        .form-box textarea { width: 100%; padding: 1rem; border: 2px solid #e8e8e8; border-radius: 12px; font-size: 1rem; font-family: 'Montserrat', sans-serif; resize: vertical; min-height: 100px; }
        .form-box textarea:focus { border-color: var(--gold); outline: none; }
        .btn-submit { margin-top: 1rem; padding: 0.8rem 2.5rem; background: linear-gradient(135deg, var(--gold), var(--gold-light)); color: var(--text-dark); border: none; border-radius: 50px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.3s; }
        .btn-submit:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(212,175,55,0.3); }
        .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }
        .message { margin-top: 1rem; padding: 1rem; border-radius: 12px; display: none; }
        .message.success { display: block; background: #e8f5e9; color: #2e7d32; border-left: 4px solid #4CAF50; }
        .message.error { display: block; background: #ffebee; color: #c62828; border-left: 4px solid #f44336; }
        .review-card { background: white; padding: 1.5rem 2rem; border-radius: 16px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); margin-bottom: 1.5rem; border-left: 4px solid var(--gold); }
        .review-card .header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
        .review-card .name { font-weight: 700; }
        .review-card .stars { color: var(--gold); }
        .review-card .date { color: #aaa; font-size: 0.8rem; }
        .review-card .comment { margin-top: 0.5rem; color: #555; line-height: 1.6; }
        .empty-state { text-align: center; padding: 4rem; background: white; border-radius: 20px; }
        .empty-state i { font-size: 4rem; color: #ddd; display: block; margin-bottom: 1rem; }
        .toast { position: fixed; top: 100px; right: 20px; padding: 1rem 1.5rem; border-radius: 12px; color: white; font-weight: 600; box-shadow: 0 10px 40px rgba(0,0,0,0.2); z-index: 9999; animation: slideIn 0.5s ease; }
        .toast.success { background: #4CAF50; }
        .toast.error { background: #f44336; }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="reviews-page">
        <!-- Hero -->
        <div class="reviews-hero">
            <h1>Ce que disent nos <span>clientes</span></h1>
            <div class="stats">
                <div><span class="num"><%= averageRating || 0 %></span><span class="label">⭐ Note</span></div>
                <div><span class="num"><%= totalReviews || 0 %></span><span class="label">📝 Avis</span></div>
                <div><span class="num">98%</span><span class="label">😊 Satisfaction</span></div>
            </div>
        </div>

        <!-- Formulaire -->
        <div class="form-box">
            <h2>💬 Donnez votre avis</h2>
            <p class="sub">Votre expérience nous aide à nous améliorer.</p>

            <% if (user) { %>
                <p>Bonjour <strong><%= user.name %></strong> 👋</p>

                <div class="stars-selector" id="starsSelector">
                    <span class="star" data-value="1" onclick="setRating(1)">⭐</span>
                    <span class="star" data-value="2" onclick="setRating(2)">⭐</span>
                    <span class="star" data-value="3" onclick="setRating(3)">⭐</span>
                    <span class="star" data-value="4" onclick="setRating(4)">⭐</span>
                    <span class="star" data-value="5" onclick="setRating(5)">⭐</span>
                </div>
                <span class="rating-label" id="ratingLabel">Sélectionnez une note</span>
                <input type="hidden" id="ratingValue" value="0">

                <textarea id="commentInput" rows="4" placeholder="Racontez votre expérience..."></textarea>
                <button class="btn-submit" id="submitBtn" onclick="submitReview()">
                    <i class="fas fa-paper-plane"></i> Publier
                </button>
                <div id="reviewMessage" class="message"></div>

            <% } else { %>
                <div style="text-align:center;padding:2rem;background:#f8f8f8;border-radius:16px;">
                    <p style="margin-bottom:1rem;">Connectez-vous pour laisser un avis</p>
                    <a href="/auth/login" class="btn-hero" style="padding:0.8rem 2.5rem;display:inline-block;">Se connecter</a>
                </div>
            <% } %>
        </div>

        <!-- Liste des avis -->
        <% if (reviews && reviews.length > 0) { %>
            <% reviews.forEach(review => { %>
                <div class="review-card">
                    <div class="header">
                        <span class="name"><%= review.userName %></span>
                        <span class="stars"><%= '⭐'.repeat(review.rating) %></span>
                        <span class="date"><%= new Date(review.createdAt).toLocaleDateString('fr-FR') %></span>
                    </div>
                    <div class="comment"><%= review.comment %></div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <i class="fas fa-comment"></i>
                <p>Soyez la première à donner votre avis !</p>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>

    <script>
        let selectedRating = 0;
        const stars = document.querySelectorAll('.star');
        const ratingLabel = document.getElementById('ratingLabel');
        const labels = ['Sélectionnez une note', '⭐ Très décevant', '⭐⭐ Moyen', '⭐⭐⭐ Bon', '⭐⭐⭐⭐ Très bon', '⭐⭐⭐⭐⭐ Excellent'];

        function updateStars(rating) {
            stars.forEach(s => {
                s.classList.toggle('active', parseInt(s.dataset.value) <= rating);
            });
            ratingLabel.textContent = labels[rating] || labels[0];
        }

        function setRating(rating) {
            selectedRating = rating;
            document.getElementById('ratingValue').value = rating;
            updateStars(rating);
        }

        stars.forEach(s => {
            s.addEventListener('mouseenter', function() {
                const v = parseInt(this.dataset.value);
                stars.forEach(st => st.style.color = parseInt(st.dataset.value) <= v ? 'var(--gold)' : '#ddd');
            });
            s.addEventListener('mouseleave', function() {
                stars.forEach(st => st.style.color = parseInt(st.dataset.value) <= selectedRating ? 'var(--gold)' : '#ddd');
            });
        });

        function showToast(msg, type) {
            const old = document.querySelector('.toast');
            if (old) old.remove();
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
        }

        async function submitReview() {
            const rating = document.getElementById('ratingValue').value;
            const comment = document.getElementById('commentInput').value;
            const msgDiv = document.getElementById('reviewMessage');
            const btn = document.getElementById('submitBtn');

            if (!rating || rating === '0') {
                showToast('Sélectionnez une note ⭐', 'error');
                return;
            }
            if (!comment.trim()) {
                showToast('Écrivez votre commentaire', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '⏳ Envoi...';

            try {
                const res = await fetch('/reviews/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating, comment })
                });
                const data = await res.json();

                if (data.success) {
                    showToast('✅ Merci pour votre avis !', 'success');
                    msgDiv.className = 'message success';
                    msgDiv.textContent = '✅ Votre avis a été enregistré !';
                    msgDiv.style.display = 'block';
                    document.getElementById('commentInput').value = '';
                    setRating(0);
                    setTimeout(() => location.reload(), 2500);
                } else {
                    showToast('❌ ' + data.error, 'error');
                    msgDiv.className = 'message error';
                    msgDiv.textContent = '❌ ' + data.error;
                    msgDiv.style.display = 'block';
                }
            } catch(e) {
                showToast('❌ Erreur réseau', 'error');
            }

            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Publier';
        }
    </script>

    <script src="/js/main.js"></script>
</body>
</html>
