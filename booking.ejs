<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <div style="max-width: 1200px; margin: 4rem auto; padding: 0 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h1 style="font-family: 'Playfair Display', serif; font-size: 3rem; color: var(--primary-dark);">Réservation</h1>
                <p style="color: #666;">Réservez votre style préféré en quelques clics.</p>
            </div>
            <% if (user) { %>
                <a href="/booking/my-bookings" class="btn-hero" style="padding: 0.8rem 2rem; font-size: 1rem; display: inline-block;">
                    <i class="fas fa-calendar-check"></i> Mes réservations
                </a>
            <% } %>
        </div>

        <% if (!user) { %>
            <div style="background: #FFF3E0; padding: 1rem 1.5rem; border-radius: 12px; margin: 1.5rem 0; border-left: 4px solid #FFA000;">
                <i class="fas fa-info-circle" style="color: #FFA000;"></i>
                <span style="margin-left: 0.5rem;">Connectez-vous pour réserver ou <a href="/auth/register" style="color: var(--primary); font-weight: 600;">créez un compte</a></span>
            </div>
        <% } %>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-top: 2rem;">
            <div>
                <h2 style="font-family: 'Playfair Display', serif; color: var(--primary); margin-bottom: 2rem;">Choisissez votre style</h2>
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <% if (pages && pages.length > 0) { %>
                        <% pages.forEach(page => { %>
                            <div style="background: white; padding: 1rem 1.5rem; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; border-left: 4px solid var(--gold);">
                                <div>
                                    <h4 style="font-family: 'Playfair Display', serif; font-size: 1rem;"><%= page.title %></h4>
                                    <div style="display: flex; gap: 1rem; font-size: 0.8rem; color: #888; margin-top: 0.3rem;">
                                        <span><i class="fas fa-tag" style="color: var(--primary);"></i> $<%= page.price.min %></span>
                                        <span><i class="fas fa-clock" style="color: var(--primary);"></i> <%= page.duration %> min</span>
                                        <span><i class="fas fa-user" style="color: var(--primary);"></i> <%= page.stylist.name %></span>
                                    </div>
                                </div>
                                <a href="/pages/<%= page.pageId %>" style="padding: 0.5rem 1.5rem; background: linear-gradient(135deg, var(--gold), var(--gold-light)); color: var(--text-dark); border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 0.8rem; transition: all 0.3s ease;">Voir</a>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #666;">Aucun style disponible pour le moment.</p>
                    <% } %>
                </div>
            </div>

            <div>
                <h2 style="font-family: 'Playfair Display', serif; color: var(--primary); margin-bottom: 2rem;">Formulaire de réservation</h2>
                <form id="booking-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Nom complet</label>
                        <input type="text" name="name" value="<%= user ? user.name : '' %>" required style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Email</label>
                        <input type="email" name="email" value="<%= user ? user.email : '' %>" required style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Téléphone</label>
                        <input type="tel" name="phone" style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Style choisi</label>
                        <select name="pageId" style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                            <option value="">Sélectionnez un style</option>
                            <% if (pages && pages.length > 0) { %>
                                <% pages.forEach(page => { %>
                                    <option value="<%= page.pageId %>"><%= page.title %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Date</label>
                        <input type="date" name="date" required style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Heure</label>
                        <input type="time" name="time" required style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Message (optionnel)</label>
                        <textarea name="message" rows="3" style="width: 100%; padding: 0.8rem 1rem; border: 2px solid #e0e0e0; border-radius: 10px; font-size: 1rem; resize: vertical;"></textarea>
                    </div>
                    <button type="submit" style="padding: 1rem 2rem; background: linear-gradient(135deg, var(--gold), var(--gold-light)); color: var(--text-dark); border: none; border-radius: 50px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.3s ease;" <%= !user ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : '' %>>
                        <i class="fas fa-check"></i> Réserver maintenant
                    </button>
                </form>
            </div>
        </div>
    </div>

    <footer class="footer-premium">
        <div class="footer-content">
            <div class="footer-section">
                <h4>AWA HAIRCUT DESIGN</h4>
                <p>L'excellence capillaire depuis 2024</p>
            </div>
            <div class="footer-section">
                <h5>Services</h5>
                <a href="/pages/category/coupe">Coupes</a>
                <a href="/pages/category/couleur">Couleurs</a>
                <a href="/pages/category/brushing">Brushing</a>
            </div>
            <div class="footer-section">
                <h5>À propos</h5>
                <a href="/about">Notre histoire</a>
                <a href="/stylists">Nos stylistes</a>
            </div>
            <div class="footer-section">
                <h5>Contact</h5>
                <p>+1 212 555 1234</p>
                <p>contact@awahaircut.com</p>
                <p>New York, USA</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%= currentYear %> AWA HAIRCUT DESIGN. Tous droits réservés.</p>
        </div>
    </footer>

    <script>
    document.getElementById('booking-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = {
            pageId: formData.get('pageId'),
            date: formData.get('date'),
            time: formData.get('time'),
            message: formData.get('message')
        };

        try {
            const response = await fetch('/booking/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if(result.success) {
                alert('✅ Réservation créée avec succès !');
                window.location.href = '/booking/my-bookings';
            } else {
                if(result.redirect) {
                    window.location.href = result.redirect;
                } else {
                    alert('❌ ' + result.error);
                }
            }
        } catch(error) {
            alert('Erreur réseau');
        }
    });
    </script>
</body>
</html>
