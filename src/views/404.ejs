<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header-premium">
        <nav class="nav-premium">
            <div class="logo">
                <a href="/">
                    <span class="logo-text">AWA</span>
                    <span class="logo-sub">HAIRCUT DESIGN</span>
                </a>
            </div>
            <ul class="nav-links">
                <li><a href="/">Accueil</a></li>
                <li><a href="/gallery">Galerie</a></li>
                <li><a href="/booking">Réservation</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <div style="text-align: center; padding: 8rem 2rem; min-height: 60vh;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: 6rem; color: var(--gold);">404</h1>
        <h2 style="font-family: 'Playfair Display', serif; font-size: 2rem; margin: 1rem 0;">Page non trouvée</h2>
        <p style="color: #666; font-size: 1.2rem; margin-bottom: 2rem;">La page que vous recherchez n'existe pas ou a été déplacée.</p>
        <a href="/" class="btn-hero">Retour à l'accueil</a>
    </div>

    <footer class="footer-premium">
        <div class="footer-bottom">
            <p>&copy; <%= currentYear %> AWA HAIRCUT DESIGN. Tous droits réservés.</p>
        </div>
    </footer>
</body>
</html>
