<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/images.css">
</head>
<body>
    <%- include('partials/header') %>

    <div style="max-width: 1400px; margin: 4rem auto; padding: 0 2rem;">
        <h1 style="font-family: 'Playfair Display', serif; font-size: 3rem; text-align: center; color: var(--primary-dark);">Notre Galerie</h1>
        <p style="text-align: center; font-size: 1.2rem; color: #666; max-width: 600px; margin: 1rem auto 3rem;">Découvrez nos 1000 styles de coiffure exceptionnels.</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
            <% if (pages && pages.length > 0) { %>
                <% pages.forEach(page => { %>
                    <div style="background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.05); transition: all 0.3s ease;">
                        <a href="/pages/<%= page.pageId %>" style="text-decoration: none; color: inherit;">
                            <div style="height: 250px; overflow: hidden; cursor: pointer;">
                                <img src="<%= page.images[0]?.url || '/images/placeholder.svg' %>" alt="<%= page.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onclick="event.preventDefault(); openFullscreen(this);">
                            </div>
                            <div style="padding: 1.5rem;">
                                <h3 style="font-family: 'Playfair Display', serif; font-size: 1.1rem; margin-bottom: 0.5rem;"><%= page.title %></h3>
                                <p style="color: #666; font-size: 0.9rem; margin-bottom: 0.5rem;"><%= page.description.substring(0, 80) %>...</p>
                                <div style="display: flex; gap: 1rem; font-size: 0.8rem; color: #888;">
                                    <span><i class="fas fa-tag" style="color: var(--primary);"></i> $<%= page.price.min %></span>
                                    <span><i class="fas fa-clock" style="color: var(--primary);"></i> <%= page.duration %> min</span>
                                    <span><i class="fas fa-eye" style="color: var(--primary);"></i> <%= page.views %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; grid-column: 1 / -1; color: #666;">Aucun style disponible pour le moment.</p>
            <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/zoom.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
